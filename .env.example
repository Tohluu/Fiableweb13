# Set these in Render's Environment page or your local terminal, never in HTML.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fiable
# REQUIRE_DATABASE=true
# APP_ENV=production
# For a fresh database only (omit when importing existing admins):
# ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# ADMIN_BOOTSTRAP_PASSWORD=choose-a-strong-password
