# Set these in Render's Environment page or your local terminal, never in HTML.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fiable
# REQUIRE_DATABASE=true
# APP_ENV=production
# Online checkout (set in the server environment; this app does not load .env automatically):
# PAYMENTS_ENABLED=true
# PAYMENT_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=your-secret-key
# PAYSTACK_PUBLIC_KEY=your-public-key
# Configure the Paystack webhook URL as https://YOUR-DOMAIN/api/payments/paystack/webhook
# For a fresh database only (omit when importing existing admins):
# ADMIN_BOOTSTRAP_EMAIL=owner@example.com
# ADMIN_BOOTSTRAP_PASSWORD=choose-a-strong-password
